# Copy this file to .env and fill in whichever values you need.
# Nothing here is required — the app runs fully on free/no-key sources
# with every line below left unset; each one only turns on an optional
# feature. .env is gitignored — never commit your real one.
#
# Loaded automatically by config.py (python-dotenv) for local runs. On
# Streamlit Community Cloud, set these as secrets in the app's settings
# instead (.streamlit/secrets.toml locally mirrors that same mechanism)
# — .env is a local-dev convenience, not how Streamlit Cloud reads config.

# ── Admin (gates the Monitoring page — see README's Authentication section) ─
# Both optional; Monitoring is simply unavailable to everyone until both are
# set. Auto-provisions the account on first run — you don't register it
# through the UI. Only ever *creates*; never overwrites, so changing the
# password later via the normal forgot-password flow sticks across redeploys.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Market data ──────────────────────────────────────────────────────────
# Alpha Vantage — more reliable than yfinance from cloud IPs. Free key at
# alphavantage.co
AV_API_KEY=

# OpenAlgo — your own self-hosted broker gateway (openalgo.in), for
# exchange-native NSE/BSE data. OPENALGO_BASE_URL is the root of that
# instance (e.g. http://127.0.0.1:5000, or a tunnel URL while developing
# — tunnels are ephemeral, update this when the tunnel restarts).
OPENALGO_BASE_URL=
OPENALGO_API_KEY=

# ── Macro / news ─────────────────────────────────────────────────────────
# Free FRED key (fred.stlouisfed.org) — enables macro features (Treasury
# yield, CPI).
FRED_API_KEY=
# Free NewsAPI.org dev key — broader headline coverage for sentiment.
# Falls back to yfinance's free news feed if unset.
NEWS_API_KEY=

# ── Email (OTP delivery for registration/password reset) ──────────────────
# Any SMTP provider. Without these, OTP codes are logged server-side
# instead of emailed — fine for local dev, not for a real deployment.
# Gmail: use an App Password (myaccount.google.com/apppasswords), not
# your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# ── Experiment tracking (optional, only used if requirements-ml-extra.txt
#    is installed) ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ── Durability (Docker-based deployments only — see README's Production
#    Hardening section; not used by Streamlit Community Cloud) ────────────
LITESTREAM_BUCKET_URL=

# ── Misc ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
