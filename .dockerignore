# Mirrors .gitignore's intent: keep secrets and local state out of the
# image. `COPY . .` in the Dockerfile doesn't respect .gitignore — only
# this file — so without it, local DBs and secrets would get baked in.

# Secrets / local data
users.db
track_record.db
monitoring.db
*.db-shm
*.db-wal
*.db-journal
.streamlit/secrets.toml
*.env
.env

# MLflow local tracking store
mlflow.db
mlruns/

# Dead / regenerable model artifacts
*.joblib
*.pkl

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Notebook checkpoints
.ipynb_checkpoints/

# VCS / editor / CI
.git/
.github/
.vscode/
.DS_Store
Thumbs.db

# Backups produced by scripts/backup_sqlite.py
backups/
